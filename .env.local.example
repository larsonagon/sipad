# ==========================================================
# SIPAD · Ejemplo de entorno LOCAL SEGURO (SQLite)
# ----------------------------------------------------------
# Copia este archivo a .env cuando quieras PROBAR EN LOCAL sin
# tocar la base de datos de producción:
#     cp .env.local.example .env
# Usa SQLite (archivo local), NO la BD de Render. Así los
# imports de prueba, borrados y experimentos quedan en tu
# máquina y nunca afectan los datos reales de la Alcaldía.
#
# Para volver a apuntar a producción, restaura tu .env con
# DB_ENGINE=postgres y el DATABASE_URL de Render.
# ==========================================================

# Motor de base de datos local: sqlite (archivo en backend/db/)
DB_ENGINE=sqlite

# Secreto JWT solo para desarrollo (NO reutilices el de producción)
JWT_SECRET=dev_local_no_usar_en_produccion

# Puerto local
PORT=3001

# (Opcional) Si vas a probar la capa de asistente GPT en local,
# agrega tu clave; si no, déjalo comentado.
# OPENAI_API_KEY=sk-...
